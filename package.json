{
  "name": "26-xj-fire-bid",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "新疆医科大学第一附属医院智慧消防系统等5项采购项目（XZJ266-100（3）-ZK）原型演示",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:worker": "npm run build && wrangler dev",
    "lint": "eslint . --fix",
    "db:migrate": "wrangler d1 execute Allworld --local --file=./schema.sql",
    "db:seed": "wrangler d1 execute Allworld --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute Allworld --remote --file=./schema.sql",
    "deploy": "npm run build && wrangler deploy && node scripts/deploy-allworld.mjs 26-xj-fire-bid",
    "deploy:worker": "npm run build && wrangler deploy",
    "upload:r2": "node scripts/deploy-allworld.mjs 26-xj-fire-bid",
    "deploy:r2": "node scripts/deploy-allworld.mjs 26-xj-fire-bid",
    "r2:create": "wrangler r2 bucket create 26-xj-fire-bid-assets"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "echarts": "^5.6.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.4.1",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "^9.33.0",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^22.17.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^5.4.19",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^2.2.10",
    "wrangler": "^4.28.0"
  }
}
